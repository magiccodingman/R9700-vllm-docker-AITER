# Image/container identity
# Default stack is Ubuntu 26 + the latest ROCm apt stack currently published by AMD.
IMAGE_NAME=r9700-vllm:ubuntu2604-rocm724
CONTAINER_NAME=r9700-vllm

# Host paths
# This is the host folder Docker can see. It mounts into the container as /models.
MODEL_DIR=/mnt/fastdisk/ai-models
CACHE_DIR=/mnt/fastdisk/r9700-vllm-cache
LOG_DIR=./logs

# Docker group IDs from host. Fill these with:
# export VIDEO_GID="$(getent group video | cut -d: -f3)"
# export RENDER_GID="$(getent group render | cut -d: -f3)"
VIDEO_GID=44
RENDER_GID=109

# Runtime defaults. Override per machine/run.
HIP_VISIBLE_DEVICES=0,1
ROCR_VISIBLE_DEVICES=0,1
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=1
VLLM_PORT=8000
SHM_SIZE=32gb

# ROCm stack selector for scripts/r9700-vllm.py.
# Accepted values: preview, stable, custom.
# - preview currently tracks the newest AMD apt repo that exists publicly.
# - stable is the same known-good ROCm 7.2.4 path right now.
# - custom leaves explicit values untouched.
ROCM_STACK=preview

# Build knobs: Ubuntu 26 + published ROCm apt defaults.
# AMD's public apt index currently has ROCm 7.2.4, but not 7.13.0.
ROCM_BASE_IMAGE=ubuntu:26.04
ROCM_APT_VERSION=7.2.4
ROCM_APT_CODENAME=noble
ROCM_APT_PACKAGES=rocm-dev rocm-libs rocminfo rocm-smi-lib rccl
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/rocm7.2
PYTORCH_PACKAGES=torch torchvision torchaudio
AMD_TRITON_INDEX_URL=https://pypi.amd.com/triton/release_/rocm-7.2.0/simple/
TRITON_PACKAGES=triton==3.7.0 triton-kernels==1.0.0
VLLM_FINAL_BRANCH=r9700-c3284-secondary
MAX_JOBS=8
# Radeon AI PRO R9700 / RDNA4 target.
PYTORCH_ROCM_ARCH=gfx1201

# When AMD publishes ROCm 7.13.0 packages, switch these back to the preview path:
# IMAGE_NAME=r9700-vllm:rocm713-preview
# ROCM_APT_VERSION=7.13.0
# ROCM_APT_CODENAME=<published distro codename>
# PYTORCH_INDEX_URL=https://download.pytorch.org/whl/nightly/rocm7.13
# PYTORCH_PACKAGES=--pre torch torchvision torchaudio
# AMD_TRITON_INDEX_URL=https://pypi.amd.com/triton/release_/rocm-7.13.0/simple/
# TRITON_PACKAGES=triton triton-kernels

# Giant PyTorch ROCm wheels can be multiple GB. These keep pip from giving up mid-download.
# Timeout is per quiet socket read, not a total build duration limit.
PIP_DEFAULT_TIMEOUT=7200
PIP_RETRIES=100

# Runtime launch wrapper. vLLM/AITER toggles should live here, not in Dockerfile ENV.
LAUNCHER_REPO=https://github.com/magiccodingman/VllmLaunchScriptR9700.git
LAUNCHER_REF=main
VLLM_LAUNCH_SCRIPT=/opt/r9700-vllm/launcher/launch_vllm.py
