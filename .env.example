# Image/container identity
# Default stack is the ROCm 7.13.0 Technology Preview for RDNA4/gfx120X.
IMAGE_NAME=r9700-vllm:rocm7130-preview
CONTAINER_NAME=r9700-vllm

# Host paths
# This is the host folder Docker can see. It mounts into the container as /models.
MODEL_DIR=/mnt/fastdisk/ai-models
CACHE_DIR=/mnt/fastdisk/r9700-vllm-cache
LOG_DIR=./logs

# Docker group IDs from host. Fill these with:
# export VIDEO_GID="$(getent group video | cut -d: -f3)"
# export RENDER_GID="$(getent group render | cut -d: -f3)"
VIDEO_GID=44
RENDER_GID=109

# Runtime defaults. Override per machine/run.
HIP_VISIBLE_DEVICES=0,1
ROCR_VISIBLE_DEVICES=0,1
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=1
VLLM_PORT=8000
SHM_SIZE=32gb

# ROCm stack selector for scripts/r9700-vllm.py.
# Accepted values: preview, custom.
# - preview enforces the ROCm 7.13.0 Technology Preview defaults below.
# - custom leaves explicit values untouched for deliberate experiments.
ROCM_STACK=preview

# ROCm 7.13.0 Technology Preview userspace/development stack.
# The official TheRock gfx120X tarball is extracted into /opt/rocm.
ROCM_BASE_IMAGE=ubuntu:24.04
ROCM_VERSION=7.13.0
ROCM_TARBALL_URL=https://repo.amd.com/rocm/tarball/therock-dist-linux-gfx120X-all-7.13.0.tar.gz

# Exact AMD ROCm 7.13.0 PyTorch wheels for the R9700/gfx1201.
PYTORCH_INDEX_URL=https://repo.amd.com/rocm/whl/gfx120X-all/
PYTORCH_PACKAGES=torch==2.11.0+rocm7.13.0 torchvision==0.26.0+rocm7.13.0 torchaudio==2.11.0+rocm7.13.0

# vLLM is built directly from this repository and ref.
# rdna4-dev is the default, but VLLM_REF can be set to main or any other branch,
# tag, or commit accepted by git checkout before building.
VLLM_REPO=https://github.com/magiccodingman/vllm-rdna4.git
VLLM_REF=rdna4-dev

MAX_JOBS=8
# Radeon AI PRO R9700 / RDNA4 target.
PYTORCH_ROCM_ARCH=gfx1201

# Giant ROCm/PyTorch downloads can be multiple GB. These keep pip from giving up mid-download.
# Timeout is per quiet socket read, not a total build duration limit.
PIP_DEFAULT_TIMEOUT=7200
PIP_RETRIES=100
